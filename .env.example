# MindChat Environment Variables

# Supabase Backend Configuration (optional for Demo/Local mode, required for remote production sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Service Configuration
# AI calls are securely proxied or executed with built-in client intelligence fallback
VITE_AI_PROVIDER=mindchat-neural-engine
VITE_AI_API_ENDPOINT=
VITE_AI_API_KEY=

# Translation Service Configuration
# Supports Indian languages (Kannada, Hindi, Telugu, Tamil, Malayalam, Marathi, Bengali, Gujarati, Punjabi, Odia, Assamese, Urdu, English)
VITE_TRANSLATION_PROVIDER=indic-trans-v2
VITE_TRANSLATION_API_KEY=

# Application Mode: 'demo' | 'production'
VITE_APP_MODE=demo
